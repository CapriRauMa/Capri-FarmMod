-- ==================== SILENT NPC ====================
local function SelectSilentNPCTarget()
    if not _G.SilentNPCEnabled then
        return nil
    end

    if IsAliveMob(currentFarmTarget) then
        local hrp = currentFarmTarget:FindFirstChild("HumanoidRootPart")
        local myRoot = GetHRP()
        if hrp and (not myRoot or (hrp.Position - myRoot.Position).Magnitude <= math.max(_G.SilentMaxDist or 700, _G.NearRange or 700)) then
            return hrp
        end
    end

    local root = GetHRP()
    if not root then return nil end

    local maxRange = math.max(_G.SilentMaxDist or 700, _G.NearRange or 700)
    local bestPart = nil
    local shortest = maxRange

    local potential = {}
    local enemies = Workspace:FindFirstChild("Enemies")
    if enemies then
        for _, e in ipairs(enemies:GetChildren()) do
            table.insert(potential, e)
        end
    end
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and obj ~= GetChar() then
            local hum = obj:FindFirstChildOfClass("Humanoid")
            local hrp = obj:FindFirstChild("HumanoidRootPart")
            if hum and hrp and not Players:GetPlayerFromCharacter(obj) then
                table.insert(potential, obj)
            end
        end
    end

    for _, char in ipairs(potential) do
        local hPart = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hPart and hum and hum.Health > 0 and not Players:GetPlayerFromCharacter(char) then
            local mag = (hPart.Position - root.Position).Magnitude
            if mag <= maxRange and mag < shortest then
                shortest = mag
                bestPart = hPart
            end
        end
    end

    return bestPart
end

