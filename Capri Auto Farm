local function CopyKeyMap(srcMap, targetMap, keyList)
    if type(srcMap) ~= "table" then return end
    for _, k in ipairs(keyList) do
        if type(srcMap[k]) == "boolean" then
            targetMap[k] = srcMap[k]
        end
    end
end

local function LoadSettings()
    local loaded = nil

    if type(isfile) == "function" and type(readfile) == "function" then
        pcall(function()
            if isfile(SETTINGS_FILE) then
                local raw = readfile(SETTINGS_FILE)
                if raw and raw ~= "" then
                    loaded = HttpService:JSONDecode(raw)
                end
            end
        end)
    end

    if type(loaded) ~= "table" and type(getgenv().CapriFarmSavedSettings) == "table" then
        loaded = getgenv().CapriFarmSavedSettings
    end

    if type(loaded) == "table" then
        if type(loaded.WeaponType) == "string" then Config.WeaponType = loaded.WeaponType end
        if type(loaded.BringEnabled) == "boolean" then Config.BringEnabled = loaded.BringEnabled end
        if type(loaded.BringMode) == "string" then Config.BringMode = loaded.BringMode end
        if type(loaded.BringRange) == "number" then Config.BringRange = loaded.BringRange end
        if type(loaded.NearRange) == "number" then Config.NearRange = loaded.NearRange end
        if type(loaded.FarmHeight) == "number" then Config.FarmHeight = loaded.FarmHeight end
        if type(loaded.TweenSpeed) == "number" then Config.TweenSpeed = loaded.TweenSpeed end
        if type(loaded.AutoV4) == "boolean" then Config.AutoV4 = loaded.AutoV4 end
        if type(loaded.SilentNPCEnabled) == "boolean" then Config.SilentNPCEnabled = loaded.SilentNPCEnabled end
        if type(loaded.VisualHitbox) == "boolean" then Config.VisualHitbox = loaded.VisualHitbox end

        if type(loaded.MeleeMasteryEnabled) == "boolean" then Config.MeleeMasteryEnabled = loaded.MeleeMasteryEnabled end
        if type(loaded.MeleeSkillHP) == "number" then Config.MeleeSkillHP = loaded.MeleeSkillHP end
        CopyKeyMap(loaded.MeleeSelectedKeys, Config.MeleeSelectedKeys, MELEE_KEYS)

        if type(loaded.SwordMasteryEnabled) == "boolean" then Config.SwordMasteryEnabled = loaded.SwordMasteryEnabled end
        if type(loaded.SwordSkillHP) == "number" then Config.SwordSkillHP = loaded.SwordSkillHP end
        CopyKeyMap(loaded.SwordSelectedKeys, Config.SwordSelectedKeys, SHORT_WEAPON_KEYS)

        if type(loaded.GunMasteryEnabled) == "boolean" then Config.GunMasteryEnabled = loaded.GunMasteryEnabled end
        if type(loaded.GunSkillHP) == "number" then Config.GunSkillHP = loaded.GunSkillHP end
        CopyKeyMap(loaded.GunSelectedKeys, Config.GunSelectedKeys, SHORT_WEAPON_KEYS)

        if type(loaded.FruitMasteryEnabled) == "boolean" then Config.FruitMasteryEnabled = loaded.FruitMasteryEnabled end
        if type(loaded.FruitSkillHP) == "number" then Config.FruitSkillHP = loaded.FruitSkillHP end
        CopyKeyMap(loaded.FruitSelectedKeys, Config.FruitSelectedKeys, FRUIT_KEYS)
    end

    getgenv().Config.AutoV4 = Config.AutoV4
    getgenv().Config.HoldWeapon = Config.WeaponType
    SyncGlobalSkillLists()
end

