local function ScanMobs()
    local hrp = GetHRP()
    local enemies = workspace:FindFirstChild("Enemies")
    local counts = {}
    local list = {}

    if enemies then
        for _, mob in ipairs(enemies:GetChildren()) do
            if IsAliveMob(mob) then
                local ok = true
                if hrp then
                    ok = (mob.HumanoidRootPart.Position - hrp.Position).Magnitude <= 3000
                end
                if ok then
                    if not counts[mob.Name] then
                        counts[mob.Name] = 0
                        table.insert(list, mob.Name)
                    end
                    counts[mob.Name] += 1
                end
            end
        end
    end

    if #list == 0 and enemies then
        for _, mob in ipairs(enemies:GetChildren()) do
            if IsAliveMob(mob) then
                if not counts[mob.Name] then
                    counts[mob.Name] = 0
                    table.insert(list, mob.Name)
                end
                counts[mob.Name] += 1
            end
        end
    end

    table.sort(list)
    return list, counts
end

local function BringMobs(centerPos, targetName)
    if not Config.BringEnabled or not centerPos then
        ClearVisualHitboxes()
        return
    end
    if not Config.VisualHitbox then
        ClearVisualHitboxes()
    end

    local enemies = workspace:FindFirstChild("Enemies")
    if not enemies then return end

    pcall(function()
        sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
    end)

    local isMixed = (Config.BringMode == "Mixed / All")
    local idx = 0

    for _, mob in ipairs(enemies:GetChildren()) do
        if IsAliveMob(mob) then
            local canBring = isMixed or (targetName == nil) or (mob.Name == targetName)
            if canBring then
                local mhrp = mob.HumanoidRootPart
                local mhum = mob.Humanoid
                if (mhrp.Position - centerPos).Magnitude <= Config.BringRange then
                    idx += 1
                    local angle = (idx % 8) * (math.pi / 4)
                    local spread = Vector3.new(math.cos(angle) * 2.5, -2, math.sin(angle) * 2.5)
                    local destCF = CFrame.new(centerPos + spread)
                    pcall(function()
                        mhum.WalkSpeed = 0
                        mhum.JumpPower = 0
                        mhrp.CanCollide = false
                        mhrp.Anchored = false
                        mhrp.AssemblyLinearVelocity = Vector3.zero
                        mhrp.AssemblyAngularVelocity = Vector3.zero
                        mhrp.Size = Vector3.new(2, 2, 1)
                        mhrp.CFrame = destCF
                    end)
                    UpdateVisualHitbox(mob, destCF)
                end
            end
        end
    end
end

