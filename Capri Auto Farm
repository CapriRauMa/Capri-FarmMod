local function GetHRP()
    local char = GetChar()
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function GetHum()
    local char = GetChar()
    return char and char:FindFirstChildOfClass("Humanoid")
end

local function IsAliveMob(mob)
    if not mob or not mob.Parent then return false end
    if Players:GetPlayerFromCharacter(mob) then return false end
    local hum = mob:FindFirstChildOfClass("Humanoid")
    local hrp = mob:FindFirstChild("HumanoidRootPart")
    return hum and hrp and hum.Health > 0
end

local function IsV4Ready()
    local char = GetChar()
    if not char then return false end

    local awakening = char:FindFirstChild("Awakening") or char:FindFirstChild("RaceV4") or char:FindFirstChild("V4Active")
    if awakening then
        if awakening:IsA("BoolValue") then
            return not awakening.Value
        elseif awakening:IsA("NumberValue") or awakening:IsA("IntValue") then
            return awakening.Value <= 0
        end
    end

    for _, container in ipairs({char, LocalPlayer}) do
        for _, child in ipairs(container:GetChildren()) do
            local lower = string.lower(child.Name)
            if string.find(lower, "v4") or string.find(lower, "awaken") or string.find(lower, "energy") or string.find(lower, "meter") then
                if child:IsA("BoolValue") and child.Value == true then
                    return true
                elseif child:IsA("NumberValue") or child:IsA("IntValue") then
                    if child.Value >= 100 then
                        return true
                    end
                end
            end
        end
    end

    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if playerGui then
        for _, desc in ipairs(playerGui:GetDescendants()) do
            local lowerName = string.lower(desc.Name)
            if (string.find(lowerName, "v4") or string.find(lowerName, "awaken") or string.find(lowerName, "race")) and (desc:IsA("Frame") or desc:IsA("ImageLabel")) then
                local sizeX = desc.Size.X.Scale
                if sizeX and sizeX >= 0.99 then
                    return true
                end
            end
        end
    end

    return true
end

local function TryActivateV4()
    if not Config.AutoV4 then return end
    local now = os.clock()
    if now - lastV4Trigger < 1.2 then return end

    local char = GetChar()
    local hum = GetHum()
    if not (char and hum and hum.Health > 0) then return end

    if not IsV4Ready() then return end
    lastV4Trigger = now

    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Y, false, game)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Y, false, game)
    end)

    pcall(function()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local commE = remotes and remotes:FindFirstChild("CommE")
        if commE and commE:IsA("RemoteEvent") then
            commE:FireServer("ActivateV4")
        end
    end)
end

