local function UpdateVisualHitbox(mobModel, anchorCFrame)
    if not Config.VisualHitbox or not mobModel or not mobModel.Parent or not anchorCFrame then
        return
    end

    local visName = "Vis_" .. tostring(mobModel:GetDebugId())
    local boxPart = VisualFolder:FindFirstChild(visName)
    if not boxPart then
        boxPart = Instance.new("Part")
        boxPart.Name = visName
        boxPart.Anchored = true
        boxPart.CanCollide = false
        boxPart.CanTouch = false
        boxPart.CanQuery = false
        boxPart.Massless = true
        boxPart.Material = Enum.Material.ForceField
        boxPart.Color = Color3.fromRGB(255, 85, 130)
        boxPart.Transparency = 0.78
        boxPart.Size = Vector3.new(10, 10, 10)

        local adorn = Instance.new("SelectionBox")
        adorn.Name = "Outline"
        adorn.Color3 = Color3.fromRGB(255, 105, 155)
        adorn.LineThickness = 0.04
        adorn.Adornee = boxPart
        adorn.Parent = boxPart

        boxPart.Parent = VisualFolder
    end

    boxPart.CFrame = anchorCFrame
end

