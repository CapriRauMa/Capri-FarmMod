local function DoScan()
    local list, counts = ScanMobs()
    if #list > 0 then
        if not Config.SelectedMob or not table.find(list, Config.SelectedMob) then
            Config.SelectedMob = list[1]
        end
        UpdateMobCycle(list, Config.SelectedMob)
        local summary = {}
        for i = 1, math.min(#list, 3) do
            local n = list[i]
            table.insert(summary, n .. " (" .. tostring(counts[n]) .. ")")
        end
        StatusBox.Text = "Chọn: " .. tostring(Config.SelectedMob) .. " | " .. table.concat(summary, ", ")
    else
        Config.SelectedMob = nil
        UpdateMobCycle({"Chưa có quái"}, nil)
        StatusBox.Text = "Không tìm thấy quái sống gần đây. Hãy lại gần đảo rồi bấm Quét Đảo."
    end
end

