-- Helper tạo nút nhỏ gọn trong từng Tab
local function CreateRowBuilder(parentFrame)
    local idxOrder = 0
    local function nextOrd()
        idxOrder += 1
        return idxOrder
    end

    local function AddToggle(labelText, initial, onToggle)
        local btn = Instance.new("TextButton")
        btn.LayoutOrder = nextOrd()
        btn.Size = UDim2.new(1, 0, 0, 24)
        btn.BorderSizePixel = 0
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 10
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Parent = parentFrame
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 3)

        local state = initial
        local function paint()
            btn.BackgroundColor3 = state and Color3.fromRGB(40, 145, 75) or Color3.fromRGB(36, 36, 48)
            btn.Text = string.format("%s: %s", labelText, state and "BẬT" or "TẮT")
        end
        paint()

        btn.MouseButton1Click:Connect(function()
            state = not state
            paint()
            onToggle(state)
        end)

        return btn, function(newVal)
            if state ~= newVal then
                state = newVal
                paint()
            end
        end
    end

    local function AddButton(labelText, color, onClick)
        local btn = Instance.new("TextButton")
        btn.LayoutOrder = nextOrd()
        btn.Size = UDim2.new(1, 0, 0, 24)
        btn.BackgroundColor3 = color or Color3.fromRGB(52, 85, 165)
        btn.BorderSizePixel = 0
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 10
        btn.Text = labelText
        btn.Parent = parentFrame
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 3)
        btn.MouseButton1Click:Connect(onClick)
        return btn
    end

    local function AddCycle(prefix, options, startIdx, onChange)
        local cur = startIdx or 1
        local btn = Instance.new("TextButton")
        btn.LayoutOrder = nextOrd()
        btn.Size = UDim2.new(1, 0, 0, 24)
        btn.BackgroundColor3 = Color3.fromRGB(42, 42, 56)
        btn.BorderSizePixel = 0
        btn.TextColor3 = Color3.fromRGB(240, 240, 255)
        btn.Font = Enum.Font.GothamBold
        btn.TextSize = 10
        btn.Parent = parentFrame
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 3)

        local function refresh()
            btn.Text = string.format("%s: %s", prefix, tostring(options[cur]))
        end
        refresh()

        btn.MouseButton1Click:Connect(function()
            cur += 1
            if cur > #options then cur = 1 end
            refresh()
            onChange(options[cur])
        end)

        return btn, function(newOpts, selectedNameOrValue)
            if type(newOpts) == "table" then
                options = (#newOpts > 0) and newOpts or {"Chưa có quái"}
            end
            cur = 1
            if selectedNameOrValue ~= nil then
                for i, v in ipairs(options) do
                    if v == selectedNameOrValue then
                        cur = i
                        break
                    end
                end
            end
            refresh()
        end
    end

    local function AddSkillKeyRow(prefixLabel, keyMap, keyList, onKeysChanged)
        local keys = keyList or FRUIT_KEYS
        local row = Instance.new("Frame")
        row.LayoutOrder = nextOrd()
        row.Size = UDim2.new(1, 0, 0, 24)
        row.BackgroundColor3 = Color3.fromRGB(30, 30, 42)
        row.BorderSizePixel = 0
        row.Parent = parentFrame
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 3)

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0.42, 0, 1, 0)
        lbl.Position = UDim2.new(0, 6, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = prefixLabel
        lbl.TextColor3 = Color3.fromRGB(220, 225, 240)
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 10
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = row

        local keyBtns = {}
        local count = #keys
        for i, keyName in ipairs(keys) do
            local kBtn = Instance.new("TextButton")
            local widthScale = 0.56 / count
            kBtn.Size = UDim2.new(widthScale, -3, 0, 20)
            kBtn.Position = UDim2.new(0.43 + (i - 1) * widthScale, 1, 0.5, -10)
            kBtn.BorderSizePixel = 0
            kBtn.Font = Enum.Font.GothamBold
            kBtn.TextSize = 10
            kBtn.Text = keyName
            kBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            kBtn.Parent = row
            Instance.new("UICorner", kBtn).CornerRadius = UDim.new(0, 3)

            local function paintKey()
                local active = keyMap[keyName] == true
                kBtn.BackgroundColor3 = active and Color3.fromRGB(40, 145, 75) or Color3.fromRGB(46, 46, 62)
            end
            paintKey()

            kBtn.MouseButton1Click:Connect(function()
                keyMap[keyName] = not (keyMap[keyName] == true)
                paintKey()
                if onKeysChanged then
                    onKeysChanged()
                end
            end)

            keyBtns[keyName] = paintKey
        end

        return function()
            for _, paintFn in pairs(keyBtns) do
                paintFn()
            end
        end
    end

    local function AddLabel(txt, height)
        local lbl = Instance.new("TextLabel")
        lbl.LayoutOrder = nextOrd()
        lbl.Size = UDim2.new(1, 0, 0, height or 24)
        lbl.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
        lbl.BorderSizePixel = 0
        lbl.TextColor3 = Color3.fromRGB(210, 220, 235)
        lbl.Font = Enum.Font.Gotham
        lbl.TextSize = 10
        lbl.TextWrapped = true
        lbl.Text = txt
        lbl.Parent = parentFrame
        Instance.new("UICorner", lbl).CornerRadius = UDim.new(0, 3)
        return lbl
    end

    return {
        Toggle = AddToggle,
        Button = AddButton,
        Cycle = AddCycle,
        SkillRow = AddSkillKeyRow,
        Label = AddLabel
    }
end

