local function CloneValue(v)
    if type(v) == "table" then
        local copy = {}
        for k, val in pairs(v) do
            copy[k] = CloneValue(val)
        end
        return copy
    end
    return v
end

for key, defaultValue in pairs(Defaults) do
    if _G[key] == nil then
        _G[key] = CloneValue(defaultValue)
    end
end

local function BuildSkillList(keyMap, keyList)
    local out = {}
    if type(keyMap) ~= "table" then return out end
    for _, k in ipairs(keyList) do
        if keyMap[k] then
            table.insert(out, k)
        end
    end
    return out
end

local function SyncSkillGlobals()
    _G.MeleeSkills = BuildSkillList(_G.MeleeSelectedKeys, MELEE_KEYS)
    _G.SwordSkills = BuildSkillList(_G.SwordSelectedKeys, SHORT_WEAPON_KEYS)
    _G.GunSkills = BuildSkillList(_G.GunSelectedKeys, SHORT_WEAPON_KEYS)
