local function StopMovement()
    isTweening = false
    activeAnchorPos = nil
    ClearVisualHitboxes()
    if CurrentTween then
        pcall(function() CurrentTween:Cancel() end)
        CurrentTween = nil
    end
    ClearTelePart()
    local hrp = GetHRP()
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        if hrp:FindFirstChild("BodyClip") then
            pcall(function() hrp.BodyClip:Destroy() end)
        end
    end
end

local function HoldStablePosition(desiredPos, lookAtPos)
    local hrp = GetHRP()
    local hum = GetHum()
    if not (hrp and hum and hum.Health > 0) then return end

    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    local currentPos = hrp.Position
    local smoothPos = currentPos:Lerp(desiredPos, 0.35)
    if (desiredPos - currentPos).Magnitude < 0.35 then
        smoothPos = desiredPos
    end

    if lookAtPos then
        local flatLook = Vector3.new(lookAtPos.X, smoothPos.Y, lookAtPos.Z)
        if (flatLook - smoothPos).Magnitude > 0.05 then
            hrp.CFrame = CFrame.lookAt(smoothPos, flatLook)
        else
            hrp.CFrame = CFrame.new(smoothPos)
        end
    else
        hrp.CFrame = CFrame.new(smoothPos)
    end
end

local function MoveToCFrame(targetCF)
    if not targetCF then return end
    local char = GetChar()
    local hum = GetHum()
    local hrp = GetHRP()
    if not (char and hum and hrp and hum.Health > 0) then return end

    local dist = (targetCF.Position - hrp.Position).Magnitude
    if dist <= 75 then
        if CurrentTween then
            pcall(function() CurrentTween:Cancel() end)
            CurrentTween = nil
        end
        isTweening = false
        ClearTelePart()
        HoldStablePosition(targetCF.Position, activeAnchorPos)
        return
    end

    local part = char:FindFirstChild("PartTele")
    if not part then
        part = Instance.new("Part")
        part.Name = "PartTele"
        part.Size = Vector3.new(6, 1, 6)
        part.Anchored = true
        part.Transparency = 1
        part.CanCollide = false
        part.CFrame = CFrame.new(hrp.Position)
        part.Parent = char
    end

    isTweening = true
    local speed = math.max(tonumber(Config.TweenSpeed) or 350, 80)
    local duration = math.max(dist / speed, 0.04)

    if CurrentTween then
        pcall(function() CurrentTween:Cancel() end)
    end

    CurrentTween = TweenService:Create(part, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = CFrame.new(targetCF.Position)})
    CurrentTween:Play()

    local elapsed = 0
    while isTweening and elapsed < duration do
        task.wait(0.03)
        elapsed += 0.03
        if not (Config.AutoSelected or Config.AutoNear) then
            break
        end
        local curHRP = GetHRP()
        if curHRP and part and part.Parent then
            curHRP.AssemblyLinearVelocity = Vector3.zero
            curHRP.AssemblyAngularVelocity = Vector3.zero
            curHRP.CFrame = CFrame.new(part.Position)
            if activeAnchorPos and (curHRP.Position - activeAnchorPos).Magnitude <= 75 then
                break
            end
        end
    end

    if CurrentTween then
        pcall(function() CurrentTween:Cancel() end)
        CurrentTween = nil
    end
    isTweening = false
    ClearTelePart()
end

