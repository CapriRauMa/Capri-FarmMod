local function CollectConfig()
    local data = {}
    for key in pairs(Defaults) do
        data[key] = CloneValue(_G[key])
    end
    return data
end

local function SaveConfig()
    if typeof(writefile) ~= "function" then return end
    pcall(function()
        writefile(CONFIG_FILE, HttpService:JSONEncode(CollectConfig()))
    end)
end

local function LoadConfig()
    if typeof(isfile) ~= "function" or typeof(readfile) ~= "function" then return end
    if not isfile(CONFIG_FILE) then return end
    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(readfile(CONFIG_FILE))
    end)
    if ok and type(decoded) == "table" then
        for key, defaultValue in pairs(Defaults) do
            if decoded[key] ~= nil then
                if type(defaultValue) == "table" and type(decoded[key]) == "table" then
                    local merged = CloneValue(defaultValue)
                    for k, v in pairs(decoded[key]) do
                        merged[k] = v
                    end
                    _G[key] = merged
                else
                    _G[key] = decoded[key]
                end
            end
        end
        SyncSkillGlobals()
    end
end

