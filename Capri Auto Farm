local SETTINGS_FILE = "CapriFarm_Settings.json"

local function SaveSettings()
    local payload = {
        WeaponType = Config.WeaponType,
        BringEnabled = Config.BringEnabled,
        BringMode = Config.BringMode,
        BringRange = Config.BringRange,
        NearRange = Config.NearRange,
        FarmHeight = Config.FarmHeight,
        TweenSpeed = Config.TweenSpeed,
        AutoV4 = Config.AutoV4,
        VisualHitbox = Config.VisualHitbox
    }

    getgenv().CapriFarmSavedSettings = payload
    getgenv().Config.AutoV4 = Config.AutoV4
    getgenv().Config.HoldWeapon = Config.WeaponType

    if type(writefile) == "function" then
        local ok = pcall(function()
            writefile(SETTINGS_FILE, HttpService:JSONEncode(payload))
        end)
        return ok
    end
    return true
end

local function LoadSettings()
    local loaded = nil

    if type(isfile) == "function" and type(readfile) == "function" then
        pcall(function()
            if isfile(SETTINGS_FILE) then
                local raw = readfile(SETTINGS_FILE)
                if raw and raw ~= "" then
                    loaded = HttpService:JSONDecode(raw)
                end
            end
        end)
    end

    if type(loaded) ~= "table" and type(getgenv().CapriFarmSavedSettings) == "table" then
        loaded = getgenv().CapriFarmSavedSettings
    end

    if type(loaded) == "table" then
        if type(loaded.WeaponType) == "string" then Config.WeaponType = loaded.WeaponType end
        if type(loaded.BringEnabled) == "boolean" then Config.BringEnabled = loaded.BringEnabled end
        if type(loaded.BringMode) == "string" then Config.BringMode = loaded.BringMode end
        if type(loaded.BringRange) == "number" then Config.BringRange = loaded.BringRange end
        if type(loaded.NearRange) == "number" then Config.NearRange = loaded.NearRange end
        if type(loaded.FarmHeight) == "number" then Config.FarmHeight = loaded.FarmHeight end
        if type(loaded.TweenSpeed) == "number" then Config.TweenSpeed = loaded.TweenSpeed end
        if type(loaded.AutoV4) == "boolean" then Config.AutoV4 = loaded.AutoV4 end
        if type(loaded.VisualHitbox) == "boolean" then Config.VisualHitbox = loaded.VisualHitbox end
    end

    getgenv().Config.AutoV4 = Config.AutoV4
    getgenv().Config.HoldWeapon = Config.WeaponType
end

LoadSettings()

