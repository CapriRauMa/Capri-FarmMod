local function BuildSkillList(keyMap, keyList)
    local out = {}
    for _, k in ipairs(keyList) do
        if keyMap[k] then
            table.insert(out, k)
        end
    end
    return out
end

local function SyncGlobalSkillLists()
    getgenv().Config.MeleeSkills = BuildSkillList(Config.MeleeSelectedKeys, MELEE_KEYS)
    getgenv().Config.SwordSkills = BuildSkillList(Config.SwordSelectedKeys, SHORT_WEAPON_KEYS)
    getgenv().Config.GunSkills = BuildSkillList(Config.GunSelectedKeys, SHORT_WEAPON_KEYS)
    getgenv().Config.FruitSkills = BuildSkillList(Config.FruitSelectedKeys, FRUIT_KEYS)
end

