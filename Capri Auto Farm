local function ResolveMasteryMode(targetMob)
    if not IsAliveMob(targetMob) then
        return nil, nil
    end

    local hpPct = GetMobHPPercent(targetMob)
    local candidates = {
        {
            wType = "Blox Fruit",
            enabled = _G.FruitMasteryEnabled,
            hpLimit = _G.FruitSkillHP or 30,
            skills = BuildSkillList(_G.FruitSelectedKeys, FRUIT_KEYS),
        },
        {
            wType = "Melee",
            enabled = _G.MeleeMasteryEnabled,
            hpLimit = _G.MeleeSkillHP or 30,
            skills = BuildSkillList(_G.MeleeSelectedKeys, MELEE_KEYS),
        },
        {
            wType = "Sword",
            enabled = _G.SwordMasteryEnabled,
            hpLimit = _G.SwordSkillHP or 30,
            skills = BuildSkillList(_G.SwordSelectedKeys, SHORT_WEAPON_KEYS),
        },
        {
            wType = "Gun",
            enabled = _G.GunMasteryEnabled,
            hpLimit = _G.GunSkillHP or 30,
            skills = BuildSkillList(_G.GunSelectedKeys, SHORT_WEAPON_KEYS),
        },
    }

    for _, item in ipairs(candidates) do
        if item.enabled and (hpPct <= item.hpLimit) and (#item.skills > 0) and GetWeaponByType(item.wType) then
            return item.wType, item.skills
        end
    end

    return nil, nil
end

local function TryMasterySkills(targetMob)
    if not IsAliveMob(targetMob) then
        return false
    end

    local masteryWeaponType, skills = ResolveMasteryMode(targetMob)
    if not masteryWeaponType or not skills then
        return false
    end

    local targetToolName = GetWeaponByType(masteryWeaponType)
    if targetToolName then
        EquipWeapon(targetToolName)
    end

    if UserInputService:GetFocusedTextBox() then
        return true
    end

    local now = os.clock()
    if now - lastSkillCast < 0.4 then
        return true
    end
    lastSkillCast = now

    for _, sk in ipairs(skills) do
        if not IsAliveMob(targetMob) then break end
        EquipWeapon(targetToolName)
        PressSkillKey(sk)
        task.wait(0.08)
    end

    return true
end

