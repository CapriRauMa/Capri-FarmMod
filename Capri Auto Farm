local function GetWeaponByType(wType)
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local char = GetChar()

    local function findIn(container)
        if not container then return nil end
        for _, tool in ipairs(container:GetChildren()) do
            if tool:IsA("Tool") and tool.ToolTip == wType then
                return tool.Name
            end
        end
        return nil
    end

    return findIn(char) or findIn(backpack)
end

local function GetActiveWeapon()
    local wType = Config.WeaponType
    return GetWeaponByType(wType) or wType
end

local function EquipWeapon(weaponName)
    if not weaponName then return end
    local char = GetChar()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    local hum = GetHum()
    if not (char and backpack and hum) then return end
    if char:FindFirstChild(weaponName) then return end

    local tool = backpack:FindFirstChild(weaponName)
    if not tool then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") and (item.Name == weaponName or item.ToolTip == weaponName) then
                tool = item
                break
            end
        end
    end

    if tool then
        pcall(function()
            hum:EquipTool(tool)
        end)
    end
end

local function PressSkillKey(keyStr, holdDuration)
    local keyCode = Enum.KeyCode[string.upper(tostring(keyStr))]
    if not keyCode then return end
    local holdTime = tonumber(holdDuration) or 0.1
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, keyCode, false, game)
        task.wait(math.max(holdTime, 0.03))
        VirtualInputManager:SendKeyEvent(false, keyCode, false, game)
    end)
end

-- Xác định loại vũ khí Mastery đang khả dụng theo % máu quái
local function ResolveMasteryMode(targetMob)
    if not IsAliveMob(targetMob) then
        return nil, nil
    end

    local hpPct = GetMobHPPercent(targetMob)

    local candidates = {
        {
            wType = "Blox Fruit",
            enabled = Config.FruitMasteryEnabled,
            hpLimit = Config.FruitSkillHP,
            skills = BuildSkillList(Config.FruitSelectedKeys, FRUIT_KEYS)
        },
        {
            wType = "Melee",
            enabled = Config.MeleeMasteryEnabled,
            hpLimit = Config.MeleeSkillHP,
            skills = BuildSkillList(Config.MeleeSelectedKeys, MELEE_KEYS)
        },
        {
            wType = "Sword",
            enabled = Config.SwordMasteryEnabled,
            hpLimit = Config.SwordSkillHP,
            skills = BuildSkillList(Config.SwordSelectedKeys, SHORT_WEAPON_KEYS)
        },
        {
            wType = "Gun",
            enabled = Config.GunMasteryEnabled,
            hpLimit = Config.GunSkillHP,
            skills = BuildSkillList(Config.GunSelectedKeys, SHORT_WEAPON_KEYS)
        }
    }

    for _, item in ipairs(candidates) do
        if item.enabled and (hpPct <= item.hpLimit) and (#item.skills > 0) and GetWeaponByType(item.wType) then
            return item.wType, item.skills
        end
    end

    return nil, nil
end

local function TryMasterySkills(targetMob)
    if not IsAliveMob(targetMob) then
        isMasterySwitched = false
        return false
    end

    local masteryWeaponType, skills = ResolveMasteryMode(targetMob)
    if not masteryWeaponType or not skills then
        isMasterySwitched = false
        return false
    end

    local targetToolName = GetWeaponByType(masteryWeaponType)
    if targetToolName then
        EquipWeapon(targetToolName)
        isMasterySwitched = (Config.WeaponType ~= masteryWeaponType)
    end

    if UserInputService:GetFocusedTextBox() then
        return true
    end

    local now = os.clock()
    if now - lastSkillCast < 0.4 then
        return true
    end
    lastSkillCast = now

    local gCfg = getgenv().Config or {}
    local holdMap = (type(gCfg.Hold) == "table" and type(gCfg.Hold[masteryWeaponType]) == "table") and gCfg.Hold[masteryWeaponType] or {}
    for _, sk in ipairs(skills) do
        if not IsAliveMob(targetMob) then break end
        EquipWeapon(targetToolName)
        PressSkillKey(sk, holdMap[sk] or 0.1)
        task.wait(0.08)
    end

    return true
end

